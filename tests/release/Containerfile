FROM rust:1.94.1-slim-bookworm
RUN rustup component add clippy rustfmt --toolchain 1.94.1
RUN apt-get update && apt-get install -y --no-install-recommends python3 procps ca-certificates make && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 501 --user-group --create-home runner
USER runner
WORKDIR /work
