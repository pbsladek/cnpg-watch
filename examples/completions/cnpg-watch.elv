
use builtin;
use str;

set edit:completion:arg-completer[cnpg-watch] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'cnpg-watch'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'cnpg-watch'= {
            cand --config 'config'
            cand --kube-context 'kube-context'
            cand -n 'n'
            cand --namespace 'namespace'
            cand --all-namespaces 'all-namespaces'
            cand --cluster 'cluster'
            cand --selector 'Kubernetes label selector for Cluster resources'
            cand --pooler-socket 'pooler-socket'
            cand --certificate-secret 'Explicit named certificate Secret reads (namespace/name); no Secret lists/watches'
            cand --operator-metrics-url 'Optional bounded metrics scrape; disabled unless a URL is supplied'
            cand --operator-namespace 'operator-namespace'
            cand --operator-selector 'operator-selector'
            cand --profile 'profile'
            cand --refresh 'refresh'
            cand --password-file 'password-file'
            cand --log-file 'log-file'
            cand --dump-dir 'dump-dir'
            cand --db-role 'db-role'
            cand --show-query-text 'Display bounded query text in incident wait diagnostics; dumps always redact it'
            cand --pooler-stats 'Read fixed SHOW commands over CNPG''s built-in local-peer PgBouncer console'
            cand --cluster-resources 'Observe optional cluster-scoped webhook and image catalog metadata'
            cand --no-operator-watch 'no-operator-watch'
            cand --verbose 'verbose'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
            cand completions 'Generate shell completions without reading config or contacting Kubernetes'
            cand command-reference 'Print the Markdown command reference without reading config or contacting Kubernetes'
            cand watch 'Open the observe-only dashboard (also the default command)'
            cand info 'Print paths and local configuration without contacting Kubernetes'
            cand doctor 'Check scoped access and the actual monitoring role without bootstrap changes'
            cand setup 'Review or explicitly apply runtime RBAC and PostgreSQL roles'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
